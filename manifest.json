{
  "manifest_version": 3,
  "name": "CanadaFirst",
  "version": "0.1.0",
  "description": "Shows whether the company behind the current site is Canadian (and which province), American, or other.",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://www.wikidata.org/*",
    "https://query.wikidata.org/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "CanadaFirst",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "src/options/options.html",
  "web_accessible_resources": [
    {
      "resources": ["data/companies.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
